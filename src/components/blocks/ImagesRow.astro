---
import WpImage from '../WpImage.astro';

interface Props {
  images?: Array<{ image?: { node?: any } }> | null;
  class: string;
}

const { images, class: className } = Astro.props;
---

{images && images.length > 0 && (
  <div class={className}>
    {images.map((row) => <WpImage src={row.image?.node} />)}
  </div>
)}